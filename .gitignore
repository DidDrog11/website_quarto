.Rproj.user
.Rhistory
.RData
.Ruserdata

/.quarto/
/_site/
**/*.quarto_ipynb

# API response cache written by scripts/update_publications.R
/data/cache/

# Plain PDFs of paywalled papers. Only the encrypted .enc copies are committed.
/private/*.pdf

# Personal archive of paper PDFs collected by scripts/fetch_pdfs.R. Not served; too large for git.
/papers/

# Talk decks. The source and its figures are committed, so the site can publish
# them. Output from rendering a deck on its own, which lands beside the source,
# is not; the site build writes to _site/.
/presentations/**/*.html
/presentations/**/*_files/
# ...except the HTML fragments a deck includes, which are source.
!/presentations/*/deck-*.html
