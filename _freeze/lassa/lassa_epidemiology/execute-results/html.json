ttps://pubmed.ncbi.nlm.nih.gov/1085216/\">Wulff, 1975</a> </td>\n  </tr>\n  <tr>\n   <td style=\"text-align:right;padding-left: 2em;\" indentlevel=\"1\"> 1975 </td>\n   <td style=\"text-align:left;\"> Nigeria </td>\n   <td style=\"text-align:left;\"> Rattus rattus </td>\n   <td style=\"text-align:left;\"> Culture </td>\n   <td style=\"text-align:left;\"> <a href=\"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC2366366/\">Wulff, 1975</a> </td>\n  </tr>\n  <tr>\n   <td style=\"text-align:right;padding-left: 2em;\" indentlevel=\"1\"> 2018 </td>\n   <td style=\"text-align:left;\"> Nigeria </td>\n   <td style=\"text-align:left;\"> Rattus rattus </td>\n   <td style=\"text-align:left;\"> Serology </td>\n   <td style=\"text-align:left;\"> <a href=\"https://doi.org/10.1186/s13071-018-2991-5\">Olayemi, 2018</a> </td>\n  </tr>\n  <tr grouplength=\"1\"><td colspan=\"5\" style=\"border-bottom: 1px solid;\"><strong>Arvicanthis</strong></td></tr>\n<tr>\n   <td style=\"text-align:right;padding-left: 2em;\" indentlevel=\"1\"> 1988 </td>\n   <td style=\"text-align:left;\"> Senegal </td>\n   <td style=\"text-align:left;\"> Arvicanthis niloticus </td>\n   <td style=\"text-align:left;\"> Serology </td>\n   <td style=\"text-align:left;\"> <a href=\"https://doi.org/10.1093/infdis/157.3.605\">Saluzzo, 1988</a> </td>\n  </tr>\n  <tr grouplength=\"1\"><td colspan=\"5\" style=\"border-bottom: 1px solid;\"><strong>Gerbilliscus</strong></td></tr>\n<tr>\n   <td style=\"text-align:right;padding-left: 2em;\" indentlevel=\"1\"> 1988 </td>\n   <td style=\"text-align:left;\"> Senegal </td>\n   <td style=\"text-align:left;\"> Gerbilliscus kempii </td>\n   <td style=\"text-align:left;\"> Serology </td>\n   <td style=\"text-align:left;\"> <a href=\"https://doi.org/10.1093/infdis/157.3.605\">Saluzzo, 1988</a> </td>\n  </tr>\n  <tr grouplength=\"1\"><td colspan=\"5\" style=\"border-bottom: 1px solid;\"><strong>Crocidura</strong></td></tr>\n<tr>\n   <td style=\"text-align:right;padding-left: 2em;\" indentlev